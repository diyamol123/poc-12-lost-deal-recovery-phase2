                  action:
                    "Compare competitive losses against wins, review recurring objections and identify high-value accounts where re-engagement may still be possible.",
                });
              },
            }}
          />

        </section>
      </div>

      {/* ================= INTELLIGENCE PANEL ================= */}

      <IntelligencePanel
        selected={selected}
        onClose={() => setSelected(null)}
      />
    </>
  );
}
